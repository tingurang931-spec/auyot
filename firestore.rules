rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }

    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : {};
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'tingurang931@gmail.com' ||
        request.auth.token.email == 'mmwajnnd@gmail.com' ||
        getUserData().get('role', 'user') == 'admin'
      );
    }

    function isFinance() {
      return isAuthenticated() && (isAdmin() || getUserData().get('role', 'user') == 'finance');
    }

    function isSupport() {
      return isAuthenticated() && (isAdmin() || getUserData().get('role', 'user') == 'support');
    }

    function isAccountant() {
      return isAuthenticated() && (isAdmin() || getUserData().get('role', 'user') == 'accountant');
    }

    function isEmployee() {
      return isAuthenticated() && (isAdmin() || getUserData().get('role', 'user') == 'employee');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isStaff() {
      return isAdmin() || isFinance() || isSupport() || isAccountant() || isEmployee();
    }

    // Fields on a user doc that only an admin/staff member may change.
    // Everything else on your own doc (bio, avatar, username, etc.) stays self-editable.
    function touchesOnly(allowedFields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields);
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      // You can edit your own doc, but not the admin/financial/moderation fields on it.
      allow update: if isAdmin() || isStaff() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role','deposits','suspensionStatus','isVerified','verificationStatus',
                   'verifiedAt','totalCommissionPaid','isDeleted'])
      ) || (
        // Someone else following/unfollowing you only touches your follower counters.
        isAuthenticated() &&
        touchesOnly(['followers','followersIds'])
      );
      allow delete: if isAdmin();
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /vehicles/{vehicleId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      // Listing owner and admins can edit/delete freely; any signed-in user can only
      // advance the live-auction state (bid/status fields) — not rewrite listing details.
      allow update: if isAdmin() ||
        (isAuthenticated() && resource.data.ownerId == request.auth.uid) ||
        (isAuthenticated() &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['ownerId','make','model','year','vin','odometer','startingPrice',
                     'primaryDamage','secondaryDamage','description']));
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.ownerId == request.auth.uid);
    }

    match /bids/{bidId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        (request.resource.data.userId == request.auth.uid || request.resource.data.bidderId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && (isStaff() || isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() &&
        (request.resource.data.userId == request.auth.uid || isStaff() || isAdmin());
      allow update, delete: if isStaff() || isAdmin();
    }

    match /withdrawals/{withdrawalId} {
      allow read: if isAuthenticated() && (isStaff() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isStaff() || isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isStaff() || isAdmin();
    }

    match /content_banners/{bannerId} {
      allow read: if true;
      allow write: if isStaff() || isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isStaff() || isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isStaff() || isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /dealers/{dealerId} {
      allow read: if true;
      allow write: if isStaff() || isAdmin();
    }

    match /moderation_reports/{reportId} {
      allow read: if isStaff() || isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isStaff() || isAdmin();
    }

    match /sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow write: if isStaff() || isAdmin();
    }

    match /tickets/{ticketId} {
      allow read: if isAuthenticated() && (isStaff() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isStaff() || isAdmin();
    }

    match /support_chats/{chatId} {
      allow read: if isAuthenticated() && (isStaff() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isStaff() || isAdmin();
    }

    match /support_chats/{chatId}/messages/{messageId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /appeals/{appealId} {
      allow read: if isAuthenticated() && (isStaff() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isStaff() || isAdmin();
    }

    match /verifications/{verificationId} {
      allow read: if isAuthenticated() && (isStaff() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isStaff() || isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
